# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/grete-3d.zip
/[Bb]uild/
/[Bb]uilds/
/[Ll]ibrary/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Oo]bj/
/[Tt]emp/
/[Uu]ser[Ss]ettings/
/[Uu]tils/

# Autogenerated VS/MD/Consoles solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.slnx

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# OS generated
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Python cache
__pycache__/
*.py[cod]
*$py.class

# VS Code and Visual Studio cache
.vs/
.vscode/
.utmp/
build_cli.log
build.log
